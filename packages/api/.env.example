# Copy to .env and fill in. Used by `npm run dev:api` (packages/api/package.json).

# Required
DATABASE_URL=mongodb://localhost:27017/sequenced
PORT=8080
SESSION_SECRET=                    # random string, e.g. `openssl rand -base64 32`
APP_URL=http://localhost:5173      # frontend origin, used for CORS + email links
FRONTEND_URL=http://localhost:5173 # same as APP_URL in local dev

# 2FA — encrypts TOTP secrets at rest (AES-256-GCM)
TOTP_ENCRYPTION_KEY=               # random string, e.g. `openssl rand -base64 32`

# WebAuthn / Passkeys — RP ID must equal (or be a parent domain of) whatever
# origin the browser/app is actually on, or passkeys fail with "RP ID ... is
# invalid for this domain". Comma-separate multiple domains to support more
# than one (e.g. testing the native app's associated domain from this same
# local server). "localhost" only matches a literal http(s)://localhost
# origin — not a LAN IP or tunnel hostname.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TidalTask

# Emails (optional — password reset / welcome emails no-op without these)
RESEND_API_KEY=
RESET_FROM_EMAIL=support@tidaltask.app
WELCOME_FROM_EMAIL="TidalTask <support@tidaltask.app>"
WELCOME_EMAIL_SUBJECT=Welcome to TidalTask!

# Discord webhook for update/deploy notifications (optional, no-op if unset)
UPDATES_WEBHOOK_URL=
