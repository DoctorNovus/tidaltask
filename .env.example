# Copy to .env in the repo root. Picked up by Docker Compose (docker-compose.yml /
# .habitat/docker-compose.yml) when running the full stack locally via `npm run deploy`
# (habitat build && habitat start). For an actual production server this same file is
# regenerated on every deploy from GitHub Actions secrets/variables — see README.md
# "Continuous deployment" — so hand-editing it there only matters until the next push.

# Required
DATABASE_URL=mongodb://mongouser:mongopassword@mongo:27017/sequenced?authSource=admin
PORT=8080
SESSION_SECRET=                       # random string, e.g. `openssl rand -base64 32`
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# 2FA — encrypts TOTP secrets at rest (AES-256-GCM)
TOTP_ENCRYPTION_KEY=                  # random string, e.g. `openssl rand -base64 32`

# WebAuthn / Passkeys — RP ID must equal (or be a parent domain of) whatever
# origin the browser/app is actually on. Comma-separate multiple domains if
# you need more than one to work against this same stack.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TidalTask

# Emails (optional — password reset / welcome emails no-op without these)
RESEND_API_KEY=
RESET_FROM_EMAIL=support@tidaltask.app
WELCOME_FROM_EMAIL="TidalTask <support@tidaltask.app>"
WELCOME_EMAIL_SUBJECT=Welcome to TidalTask!

# Discord webhook for update/deploy notifications (optional, no-op if unset)
UPDATES_WEBHOOK_URL=
