{
	"name": "tidaltask",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev:app",
		"dev:app": "npm --workspace packages/app run dev",
		"dev:api": "npm --workspace packages/api run dev",
		"dev:all": "npm run dev:api & npm run dev:app",
		"deploy": "habitat build && habitat start",
		"habitat:build": "habitat build",
		"habitat:start": "habitat start",
		"habitat:stop": "habitat stop"
	},
	"dependencies": {
		"@outwalk/habitat": "^0.1.0"
	}
}